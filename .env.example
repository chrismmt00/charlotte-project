# Local commands read .env.local; production commands explicitly read .env.production.
# Copy this file; never commit real credentials. Vercel uses its encrypted environment settings.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/klyvora"
# Unpooled connection for migrations; Neon hostname without -pooler.
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/klyvora"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Comma-separated team members; no public admin signup.
ADMIN_EMAILS=""
OWNER_EMAIL=""
# Klyvora billing only. Client checkout uses the client's connected account; no application fee.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"
# SMTP works with Brevo or an existing authenticated mail server. API key is optional.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM=""
BREVO_API_KEY=""
LEAD_NOTIFICATION_EMAIL=""
# Protects /api/jobs, called by Vercel Cron or npm run jobs.
CRON_SECRET=""
# Process a small durable job batch after mutations. Set false only in isolated integration tests.
AUTO_PROCESS_JOBS="true"
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Managed by scripts/setup-stripe-webhooks.mjs; identifiers are not secret.
STRIPE_WEBHOOK_ENDPOINT_ID=""
STRIPE_CONNECT_WEBHOOK_ENDPOINT_ID=""
# Cloudflare Images for public site photos.
CLOUDFLARE_IMAGES_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_API_TOKEN=""
CLOUDFLARE_IMAGES_ACCOUNT_HASH=""
# Private project uploads; configure an R2 bucket with no public access.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Private uploads remain disabled until explicitly enabled by the owner.
PRIVATE_UPLOADS_ENABLED="false"
